# Ascender Monitor Environment Configuration (Optional)
# Most settings can be configured directly in the web UI.

# Timezone (default: America/Chicago)
TZ=America/Chicago

# Path to persistent data storage (SQLite DB and config.json)
DATA_DIR=/data

# Optional initial seed credentials (if not using the Web UI to configure)
# ASCENDER_DISTRICT_ID=
# ASCENDER_USERNAME=
# ASCENDER_PASSWORD=
